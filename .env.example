# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
LANDING_PORT=4321

# Public URLs baked into the frontend/landing builds (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# Database
# POSTGRES_* initialise the postgres container; docker compose builds the in-network
# DATABASE_URL from them. DATABASE_URL below is for running the backend outside docker.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb
DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# Redis
REDIS_URL=redis://localhost:6379/0

# RustFS (S3-compatible file storage)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_BUCKET=app-bucket

# LLM — change LLM_MODEL here to switch models, no other changes needed
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_MODEL=openai/gpt-4o
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=2000

# Auth
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Seed user (created on first startup)
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=ChangeMe123!
